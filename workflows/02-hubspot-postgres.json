{
  "name": "HubSpot → PostgreSQL",
  "nodes": [
    {
      "name": "Cada día a las 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "name": "Pedir contactos a HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/objects/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "properties",
              "value": "email,firstname,lastname,lastmodifieddate"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "after",
                    "value": "={{ $response.body.paging.next.after }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging }}",
              "limitPagesFetched": true,
              "maxRequests": 50,
              "requestInterval": 200
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Separar contactos",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      }
    },
    {
      "name": "Mapear campos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        720,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "hubspot_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "email",
              "value": "={{ $json.properties.email }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "first_name",
              "value": "={{ $json.properties.firstname }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "last_name",
              "value": "={{ $json.properties.lastname }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "Date",
              "value": "={{ DateTime.fromISO($json.properties.lastmodifieddate).toFormat('dd/MM/yyyy') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Upsert en PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        960,
        0
      ],
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "hubspot_leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "hubspot_id": "={{ $json.hubspot_id }}",
            "email": "={{ $json.email }}",
            "first_name": "={{ $json.first_name }}",
            "last_name": "={{ $json.last_name }}",
            "Date": "={{ $json.Date }}"
          },
          "matchingColumns": [
            "hubspot_id"
          ],
          "schema": [
            {
              "id": "hubspot_id",
              "displayName": "hubspot_id",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "email",
              "displayName": "email",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": false
            },
            {
              "id": "first_name",
              "displayName": "first_name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": false
            },
            {
              "id": "last_name",
              "displayName": "last_name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": false
            },
            {
              "id": "Date",
              "displayName": "Date",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "retryOnFail": true,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Cada día a las 7:00": {
      "main": [
        [
          {
            "node": "Pedir contactos a HubSpot",
            "type": "main",
