    {
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst email = String(item.EmailCliente || '').trim().toLowerCase();\nconst nombre = String(item.NombreCliente || '').trim();\nconst problema = String(item.ProblemaCliente || '').trim().slice(0, 1000);\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nreturn [{ json: { NombreCliente: nombre, EmailCliente: email, ProblemaCliente: problema, entradaValida: emailOk && nombre.length > 0 && problema.length > 0 } }];"
      }
    },
